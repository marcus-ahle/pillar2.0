# Copy to .env and adjust. Every value has a local default, so .env is optional for local work.

PORT=4173
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=pillar

# ---- EZFacility ----
# Local mock (npm run mock:ez). To switch to the real API, change these values only:
#   sandbox:    https://api.sandbox.ezfacility.com
#   production: https://api.ezfacility.com
EZFACILITY_BASE_URL=http://localhost:5055
# App credentials from https://developers.ezfacility.com
EZFACILITY_CLIENT_ID=pillar-local
EZFACILITY_CLIENT_SECRET=local-mock-secret
# The EZFacility staff user the site reads the schedule as
EZFACILITY_USERNAME=pillar.api
EZFACILITY_PASSWORD=local-mock-password
EZFACILITY_SCOPE=realm:tms
# Leave blank to use the API user's first location
EZFACILITY_LOCATION_ID=
EZFACILITY_TIMEZONE=America/New_York
EZFACILITY_PAST_DAYS=45
EZFACILITY_CACHE_SECONDS=60

# ---- Mock EZFacility ----
MOCK_EZ_PORT=5055
MOCK_EZ_DB=ezfacility_mock
